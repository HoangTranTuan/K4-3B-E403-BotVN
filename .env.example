# ==============================================================================
# StoryboardAI Environment Configuration
# ==============================================================================
# Hướng dẫn: Copy file này thành file .env ở thư mục gốc:
#   Windows CMD/PowerShell: copy .env.example .env
#   Linux/macOS:            cp .env.example .env
# Lấy Gemini API Key miễn phí tại: https://aistudio.google.com/app/apikey
# LƯU Ý QUAN TRỌNG: Không commit file .env chứa API Key thật lên GitHub!

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
